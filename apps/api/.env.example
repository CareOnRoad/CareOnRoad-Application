GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_TOTAL_TIMEOUT_MS=10000
GEMINI_TIMEOUT_MS=6000
OPENROUTER_TIMEOUT_MS=4000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_ENABLE_MODEL_FALLBACK=true
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=CareOnRoad AI Chatbot MVP
SHERPA_ONNX_MODEL_DIR=./models/sherpa-onnx-zipformer-vi-30M-int8-2026-02-09
SHERPA_ONNX_ENCODER=encoder.int8.onnx
SHERPA_ONNX_DECODER=decoder.onnx
SHERPA_ONNX_JOINER=joiner.int8.onnx
SHERPA_ONNX_TOKENS=tokens.txt
ASR_ENABLED=true

# Backend database and integration tests
DATABASE_URL=
TEST_DATABASE_URL=
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_IDLE_TIMEOUT_SECONDS=20
# RUN_DB_TESTS=true
# This flag is set automatically by npm.cmd run test:db and test:full.
CHATBOT_PERSISTENCE_MODE=memory
HEALTH_READINESS_TIMEOUT_MS=1500
# For hosted DB cold connections, consider HEALTH_READINESS_TIMEOUT_MS=5000.
OPERATIONS_STUCK_DISPATCH_MINUTES=15
RUNTIME_CONTROLS_MODE=memory
RUNTIME_CONTROLS_TIMEOUT_MS=500
DATA_RETENTION_ENABLED=false
# No retention period defaults: configure only after policy approval.
# RETENTION_MEDIA_UPLOAD_INTENTS_DAYS=
# RETENTION_DEVICE_CREDENTIALS_DAYS=
# RETENTION_WORKER_RUNS_DAYS=

# Supabase authentication (backend only)
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
SUPABASE_JWKS_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_STORAGE_BUCKET=careonroad-media
MEDIA_STORAGE_TIMEOUT_MS=15000
SEED_USER_PASSWORD=

# payOS/VietQR payments (backend only; no NEXT_PUBLIC_ values)
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:3000/payment/return
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel

# Protected backend worker entry points
INTERNAL_WORKER_SECRET=
WORKER_API_BASE_URL=http://localhost:3000

# Only for a separate hosted test project using the default database name postgres.
# TEST_DATABASE_CONFIRMED=true

# Push delivery credential encryption (backend-only 32-byte key, base64 encoded)
PUSH_TOKEN_ENCRYPTION_KEY=

# Firebase Cloud Messaging HTTP v1 (backend-only service-account fields)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_TOKEN_URL=https://oauth2.googleapis.com/token
FCM_TIMEOUT_MS=8000

# Route ETA provider (backend only; Google Routes calls are disabled without a key)
ROUTE_ETA_PROVIDER=disabled
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
ROUTE_ETA_TIMEOUT_MS=3000
ROUTE_ETA_CACHE_TTL_SECONDS=60
ROUTE_ETA_LOCATION_MAX_AGE_SECONDS=300

# Live tracking is opt-in. Retention has no default and is required when enabled.
LIVE_TRACKING_ENABLED=false
# LIVE_TRACKING_RETENTION_MINUTES=
LIVE_TRACKING_MAX_LOCATION_AGE_SECONDS=30
LIVE_TRACKING_MAX_FUTURE_SKEW_SECONDS=5
LIVE_TRACKING_MIN_UPDATE_INTERVAL_SECONDS=5
LIVE_TRACKING_MAX_ACCURACY_METERS=100
