# Example env file - copy thành `.env` và điền giá trị thật.
# KHÔNG commit `.env` vào git (.gitignore đã handle).
#
# ============================================================
# Thứ tự ưu tiên khi đọc API URL (xem src/lib/config.ts):
#   1. EXPO_PUBLIC_API_BASE_URL_OVERRIDE  (set qua terminal, KHÔNG đặt ở đây)
#   2. EXPO_PUBLIC_API_BASE_URL           (file này, hoặc EAS profile)
#   3. APP_VARIANT + hardcoded fallback   (chỉ cho production build)
# ============================================================

# ---------- Backend API URL ----------
# Mặc định: http://localhost:3000 (chạy BE trên cùng máy với simulator)
# Nếu test trên thiết bị thật qua WiFi LAN, dùng `pnpm start:lan` thay vì sửa file này.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# KHÔNG ĐẶT Ở ĐÂY. Đây là biến runtime set qua terminal/CLI:
#   pnpm start:lan              # tự detect IP LAN
#   EXPO_PUBLIC_API_BASE_URL_OVERRIDE=http://192.168.1.42:3000 pnpm start
# EXPO_PUBLIC_API_BASE_URL_OVERRIDE=

# ---------- Supabase ----------
# Lấy từ Supabase Dashboard → Settings → API. KHÔNG dùng service_role key ở client.
EXPO_PUBLIC_SUPABASE_URL=https://lwgwprxjyemihlkspgjc.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_cJYGJMZR6ETtZcKuWP7uww_1KYSXFgd
