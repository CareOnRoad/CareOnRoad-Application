{
  "name": "@careonroad/mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "node scripts/start-lan.mjs",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:android": "expo export --platform android --output-dir dist",
    "prebuild": "expo prebuild --no-clean",
    "prebuild:android": "expo prebuild --no-clean --no-install --platform android",
    "check:native-sync": "node scripts/check-android-prebuild.cjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:upgrade": "node --test scripts/__tests__/*.test.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.26",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "0.511.0",
    "nativewind": "4.2.7",
    "query-string": "7.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.15",
    "eslint": "9.39.1",
    "eslint-config-expo": "~57.0.2",
    "expo-dev-client": "~57.0.20",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "6.0.3"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
