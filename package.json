{
  "name": "careonroad-application",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev:api": "pnpm --filter @careonroad/api dev",
    "dev:mobile": "pnpm --dir apps/mobile start",
    "dev:web": "pnpm --filter @careonroad/web dev",
    "build": "pnpm -r --if-present run build",
    "build:api": "pnpm --filter @careonroad/api build",
    "build:mobile": "pnpm --dir apps/mobile export:android",
    "build:web": "pnpm --filter @careonroad/web build",
    "typecheck": "pnpm --filter @careonroad/api typecheck",
    "lint": "pnpm --filter @careonroad/api lint",
    "lint:api": "pnpm --filter @careonroad/api lint",
    "lint:web": "pnpm --filter @careonroad/web lint",
    "lint:mobile": "pnpm --dir apps/mobile lint",
    "typecheck:mobile": "pnpm --dir apps/mobile typecheck",
    "check:mobile-native-sync": "pnpm --dir apps/mobile check:native-sync",
    "test": "pnpm --filter @careonroad/api test",
    "test:unit": "pnpm --filter @careonroad/api test:unit",
    "test:db": "pnpm --filter @careonroad/api test:db",
    "test:full": "pnpm --filter @careonroad/api test:full",
    "asr:smoke": "pnpm --filter @careonroad/api asr:smoke",
    "seed:mock": "pnpm --filter @careonroad/api seed:mock",
    "seed:mock:verify": "pnpm --filter @careonroad/api seed:mock:verify"
  }
}
