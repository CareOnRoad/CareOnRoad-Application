__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*
!.env.example

# Common ignores
node_modules
/.cloudflare/
.next/
out/
dist/
build/
coverage/
*.log
*.tsbuildinfo
.pnpm-store/
supabase/.temp/
.DS_Store
Thumbs.db

# ──────────────────────────────────────────────────────────────
# Mobile (Expo / React Native / Android) build & runtime output
# ──────────────────────────────────────────────────────────────
# dist/ đã có ở trên nhưng các entry cụ thể giúp tránh ignore nhầm folder
# hợp lệ trong /dist (vd: docs/dist/ — source tài liệu được track).
apps/mobile/dist-android/
apps/mobile/dist-ios/
apps/mobile/dist-test/
apps/mobile/dist-web/
apps/mobile/.expo/
apps/mobile/.expo-shared/
apps/mobile/web-build/
# Auto-generated bởi expo prebuild/sync — không cần commit
apps/mobile/expo-env.d.ts
# File log/build scratch do local EAS runner ghi ra
apps/mobile/eas-build-log.txt
apps/mobile/.eas-build-local/
# Maestro mobile testing
apps/mobile/.maestro/
# Hermes bytecode (*.hbc) và JS bundle output của Metro
*.hbc
*.jsbundle

# Android native build artifacts
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/.idea/
apps/mobile/android/.kotlin/
apps/mobile/android/.cxx/
apps/mobile/android/local.properties
apps/mobile/android/app/release/
apps/mobile/android/app/.cxx/
# Keystore không bao giờ commit (release/production). Debug keystore đã được
# track lịch sử để giữ deterministic cho môi trường dev — whitelist exception.
# Nếu muốn xoá khỏi tracking, dùng `git rm --cached` rồi commit riêng.
*.keystore
!apps/mobile/android/app/debug.keystore
*.jks
*.p12
*.p8
google-services.json
GoogleService-Info.plist

